# Sao chép thành .env và đổi toàn bộ giá trị bí mật
POSTGRES_USER=ioc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ioc
# Mật khẩu vai trò ứng dụng ioc_app (không phải superuser, chịu RLS)
APP_DB_PASSWORD=change-me-app
JWT_SECRET=change-me-to-64-random-chars
REQUIRE_2FA=false
SEED_PASSWORD=change-me-demo
APP_ENV=local
# Mã hóa bản sao lưu (giữ ở nơi an toàn, mất là không giải mã được)
BACKUP_PASSPHRASE=change-me-backup
