# Thêm vào /etc/caddy/Caddyfile, đổi tên miền rồi: sudo systemctl reload caddy
dieuhanh.example.gov.vn {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    reverse_proxy 127.0.0.1:6680 {
        # ghi đè bằng địa chỉ thật của người dùng — không chuyển tiếp X-Forwarded-For do trình duyệt tự gửi
        header_up X-Forwarded-For {remote_host}
    }
    log {
        output file /var/log/caddy/ioc-xp.log
    }
}
